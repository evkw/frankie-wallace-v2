---
import Button from '../components/Button.astro';
import Layout from '../layouts/Layout.astro';

const mockupShowcase = [
  {
    title: "Children's clothing & Swaddles",
    image: '/images/product-patterns/product-pattern-1.jpg',
    alt: "Floral artwork shown on children's clothing"
  },
  {
    title: 'Bedding',
    image: '/images/product-patterns/product-pattern-2.jpeg',
    alt: 'Hand-painted pattern mockup on fabric and baby swaddles'
  },
  {
    title: 'Nappies',
   image: '/images/product-patterns/product-pattern-3.jpg',
    alt: 'Wallpaper mockup featuring repeating floral artwork'
  },
];
---

<Layout>
  <div class="bg-blush flex flex-col items-center justify-center min-h-[80vh] py-12 md:py-16">
    <div class="max-w-3xl w-full px-6 text-center mb-10 md:mb-12">
      <h1 class="font-header text-4xl md:text-5xl leading-tight text-olive">
        Lets work together
      </h1>
      <p class="font-body text-base md:text-lg text-olive/90 mt-4 md:mt-5">
        Enquire about custom illustration or licensing my art for your products
      </p>
    </div>

    <section class="max-w-6xl w-full px-6 mb-10 md:mb-12" aria-label="Licensing mockup examples">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
        {mockupShowcase.map((mockup) => (
          <article class="bg-cream rounded-lg overflow-hidden shadow-sm border border-olive/10">
            <img
              src={mockup.image}
              alt={mockup.alt}
              loading="lazy"
              class="w-full h-56 object-cover"
            />
            <div class="px-4 py-3">
              <h3 class="font-body font-semibold text-olive text-base">{mockup.title}</h3>
            </div>
          </article>
        ))}
      </div>
    </section>

    <form action="https://formspree.io/f/movlylgz" method="POST" class="space-y-6 max-w-xl w-full font-body bg-cream p-8 rounded shadow-md">
      <div>
        <label for="name" class="block font-medium">Name <span class="text-red-500">*</span></label>
        <input type="text" name="name" id="name" required class="w-full border rounded px-3 py-2 mt-1" placeholder="e.g., Jane Smith" />
      </div>

      <div>
        <label for="email" class="block font-medium">Email <span class="text-red-500">*</span></label>
        <input type="email" name="email" id="email" required class="w-full border rounded px-3 py-2 mt-1" placeholder="e.g., hello@yourbrand.com" />
      </div>

      <div>
        <label for="service" class="block font-medium">Which Service</label>
        <select name="service" id="service" required class="w-full border rounded px-3 py-2 mt-1">
          <option value="">Select a service</option>
          <option>License an existing Surface Pattern Design</option>
          <option>Creating a custom Surface Pattern Design</option>
          <option>Childrens Book Illustration</option>
          <option>Other</option>
        </select>
      </div>

      <div>
        <label for="message" class="block font-medium">Message</label>
        <textarea name="message" id="message" rows="6" required class="w-full border rounded px-3 py-2 mt-1" placeholder="Share your project details, timeline, products, and whether you need a custom design or existing artwork."></textarea>
      </div>

      <Button type="submit"class="px-6 py-2 w-full">
        Send
      </Button>

    </form>
  </div>
</Layout>
