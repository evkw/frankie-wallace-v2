---
// HeroSection component for the main banner
import { Image } from "astro:assets";
import heroBgImage from "../../data/images/hero-bg.jpeg";
import logoImage from "../../data/images/Frankie-logo-dark.avif";
---

<section
  class="relative h-[90vh] bg-fixed bg-center bg-cover flex items-center justify-center text-center"
>
  <!-- Background Image -->
  <Image
    src={heroBgImage}
    alt="Hero background"
    class="absolute inset-0 w-full h-full object-cover"
    loading="eager"
  />

  <!-- Overlay -->
  <div class="absolute inset-0 bg-olive/10 z-0"></div>
  <div
    class="relative z-10 px-6 py-10 max-w-4xl mx-auto flex flex-col items-center"
  >
    <Image
      src={logoImage}
      alt="Frankie Wallace"
      class="h-24 sm:h-32 w-auto mb-4"
    />

    <p class="mt-4 text-lg text-cream font-body">
      Hand-painted illustrations and surface pattern design
    </p>

    <div class="flex gap-8">
      <a
        href="/gallery/surfacePattern"
        class="mt-4 inline-block bg-cream text-olive font-semibold px-6 py-2 rounded shadow hover:bg-blush transition"
      >
        Explore Pattern Collections
      </a>

      <a
        href="/licensing"
        class="mt-4 inline-block bg-cream text-olive font-semibold px-6 py-2 rounded shadow hover:bg-blush transition"
      >
        Enquire about Licensing
      </a>
    </div>
  </div>
</section>
