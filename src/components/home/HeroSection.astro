---
// HeroSection component for the main banner
import { Image } from "astro:assets";
import heroBgImage from "../../data/images/hero-bg.jpg";
import logoImage from "../../data/images/Frankie-logo-dark.avif";
---

<section
  class="relative h-[90vh] bg-fixed bg-center bg-cover flex items-center justify-center text-center"
>
  <!-- Background Image -->
  <Image
    src={heroBgImage}
    alt="Hero background"
    class="absolute inset-0 w-full h-full object-cover"
    loading="eager"
  />

  <!-- Overlay -->
  <div class="absolute inset-0 bg-olive/10 z-0"></div>
  <div
    class="relative z-10 px-6 py-10 max-w-4xl mx-auto flex flex-col items-center"
  >
    <Image
      src={logoImage}
      alt="Frankie Wallace"
      class="h-24 sm:h-32 w-auto mb-4"
    />

    <p
      class="mt-4 text-xl sm:text-2xl text-black font-bold font-heading italic flex flex-col sm:flex-row items-center justify-center gap-1 sm:gap-4"
    >
      <span>Surface Pattern Design</span>
      <span class="hidden sm:inline" aria-hidden="true">&bull;</span>
      <span>Illustration</span>
      <span class="hidden sm:inline" aria-hidden="true">&bull;</span>
      <span>Children&apos;s Books</span>
    </p>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-4 sm:gap-8">
      <a
        href="/contact"
        class="inline-block bg-olive text-cream font-semibold px-6 py-3 rounded shadow hover:bg-olive/90 transition"
      >
        Work With Me
      </a>
    </div>
  </div>
</section>
